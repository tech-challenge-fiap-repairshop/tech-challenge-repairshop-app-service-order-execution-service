    {
      "name": "04 - Aprovação e Notificação (notification-service via SQS)",
      "item": [
        {
          "name": "Passo 14 — Cliente Aprova Orçamento (Dispara SQS)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test('Aprovacao enviada para fila SQS com sucesso', function () {",
                  "    pm.expect(res.approved).to.be.true;",
                  "    pm.expect(res.status).to.eql('ORCAMENTO_APROVADO');",
                  "});"
