{
  "info": {
    "_postman_id": "696d22e8-2432-41d8-91db-2d242dc192da",
    "name": "RepairShop — Tech Challenge FIAP (Fase 4 — Microsserviços & API Gateway)",
    "description": "Collection ponta a ponta dos 4 microsserviços do RepairShop (register-service, service-order-execution-service, payment-service, notification-service) e Lambda Auth orquestrados via AWS API Gateway HTTP v2 ou localmente.\n\nContém a ordem cronológica estrita de 28 chamadas validando a Saga completa de atendimento de oficina mecânica.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Autenticação e Identidade (register-service & lambda-auth)",
      "item": [
        {
          "name": "Passo 01 — Registrar Usuário Atendente (ATTENDANT)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gerador de CPF válido com dígitos verificadores\nfunction generateValidCpf() {\n    let d = [];\n    for (let i = 0; i < 9; i++) {\n        d.push(Math.floor(Math.random() * 10));\n    }\n    let w1 = [10, 9, 8, 7, 6, 5, 4, 3, 2];\n    let s1 = 0;\n    for (let i = 0; i < 9; i++) s1 += d[i] * w1[i];\n    let r1 = s1 % 11;\n    let dv1 = r1 < 2 ? 0 : 11 - r1;\n    d.push(dv1);\n\n    let w2 = [11, 10, 9, 8, 7, 6, 5, 4, 3, 2];\n    let s2 = 0;\n    for (let i = 0; i < 10; i++) s2 += d[i] * w2[i];\n    let r2 = s2 % 11;\n    let dv2 = r2 < 2 ? 0 : 11 - r2;\n    d.push(dv2);\n\n    return d.join('');\n}",
                  "if (!pm.environment.get('attendant_cpf')) {",
                  "    const newCpf = generateValidCpf();",
                  "    pm.environment.set('attendant_cpf', newCpf);",
                  "    pm.environment.set('attendant_email', 'atendente_' + Date.now() + '@repairshop.com');",
                  "    console.log('CPF do Atendente gerado:', newCpf);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Administrador Atendente\",\n  \"function\": \"ATTENDANT\",\n  \"cpf\": \"{{attendant_cpf}}\",\n  \"email\": \"{{attendant_email}}\",\n  \"phone\": \"+55 11 98888-7777\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Cria usuário com perfil de Atendente no register-service."
          }
        },
        {
          "name": "Passo 02 — Registrar Usuário Cliente (CUSTOMER)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gerador de CPF válido com dígitos verificadores\nfunction generateValidCpf() {\n    let d = [];\n    for (let i = 0; i < 9; i++) {\n        d.push(Math.floor(Math.random() * 10));\n    }\n    let w1 = [10, 9, 8, 7, 6, 5, 4, 3, 2];\n    let s1 = 0;\n    for (let i = 0; i < 9; i++) s1 += d[i] * w1[i];\n    let r1 = s1 % 11;\n    let dv1 = r1 < 2 ? 0 : 11 - r1;\n    d.push(dv1);\n\n    let w2 = [11, 10, 9, 8, 7, 6, 5, 4, 3, 2];\n    let s2 = 0;\n    for (let i = 0; i < 10; i++) s2 += d[i] * w2[i];\n    let r2 = s2 % 11;\n    let dv2 = r2 < 2 ? 0 : 11 - r2;\n    d.push(dv2);\n\n    return d.join('');\n}",
                  "if (!pm.environment.get('customer_cpf')) {",
                  "    const newCpf = generateValidCpf();",
                  "    pm.environment.set('customer_cpf', newCpf);",
                  "    pm.environment.set('customer_email', 'cliente_' + Date.now() + '@repairshop.com');",
                  "    console.log('CPF do Cliente gerado:', newCpf);",
                  "}"
                ],
                "type": "text/javascript"
