            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200 OK ou 422 (já finalizada via auto-complete)', function () {",
                  "    pm.expect([200, 422]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    pm.test('Status da OS FINALIZED', function () {",
