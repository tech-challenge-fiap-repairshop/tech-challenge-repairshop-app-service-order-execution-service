          "name": "Passo 08 — Criar Veículo Vinculado ao Cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gerador de Placa no Padrão Mercosul (ABC1D23)\nfunction generateMercosulPlate() {\n    const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';\n    const l1 = letters.charAt(Math.floor(Math.random() * letters.length));\n    const l2 = letters.charAt(Math.floor(Math.random() * letters.length));\n    const l3 = letters.charAt(Math.floor(Math.random() * letters.length));\n    const n1 = Math.floor(Math.random() * 10);\n    const l4 = letters.charAt(Math.floor(Math.random() * letters.length));\n    const n2 = Math.floor(Math.random() * 90 + 10);\n    return `${l1}${l2}${l3}${n1}${l4}${n2}`;\n}",
                  "if (!pm.environment.get('vehicle_plate')) {",
                  "    const newPlate = generateMercosulPlate();",
                  "    pm.environment.set('vehicle_plate', newPlate);",
                  "    console.log('Placa Mercosul gerada:', newPlate);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
