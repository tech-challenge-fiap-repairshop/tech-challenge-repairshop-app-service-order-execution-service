            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cliente Proprietário\",\n  \"function\": \"CUSTOMER\",\n  \"cpf\": \"{{customer_cpf}}\",\n  \"email\": \"{{customer_email}}\",\n  \"phone\": \"+55 11 97777-6666\",\n  \"password\": \"SecurePass123!\"\n}"
