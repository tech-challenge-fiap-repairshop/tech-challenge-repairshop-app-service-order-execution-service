                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const extraId = pm.environment.get('extra_execution_id');",
                  "const soId = pm.environment.get('service_order_id');",
                  "const baseUrl = pm.environment.get('baseUrl');",
                  "const token = pm.environment.get('token_attendant');",
                  "if (extraId && soId) {",
                  "    pm.sendRequest({",
                  "        url: `${baseUrl}/service-orders/${soId}/executions/${extraId}/status`,",
                  "        method: 'PATCH',",
                  "        header: {",
                  "            'Content-Type': 'application/json',",
                  "            'Authorization': `Bearer ${token}`",
                  "        },",
                  "        body: { mode: 'raw', raw: JSON.stringify({ status: 'FINALIZED' }) }",
                  "    }, function (err, res) {",
                  "        console.log('Tarefa extra finalizada:', res.json());",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
