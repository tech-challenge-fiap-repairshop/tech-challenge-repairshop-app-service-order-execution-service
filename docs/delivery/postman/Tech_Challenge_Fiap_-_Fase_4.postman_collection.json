        {
          "name": "Passo 19 — Finalizar Tarefa Mecânica (Status FINALIZED)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
