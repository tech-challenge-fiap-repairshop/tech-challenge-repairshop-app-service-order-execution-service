        <mxCell id="61" edge="1" parent="1" style="html=1;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#B91C1C;fontColor=#B91C1C;fontSize=10;strokeWidth=1.5;" value="approve(false)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="1195" /><mxPoint x="1440" y="1242" /></Array><mxPoint x="1345" y="1195" as="sourcePoint" /><mxPoint x="1555" y="1242" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="62" edge="1" parent="1" style="html=1;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#0F172A;fontColor=#0F172A;fontSize=10;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="1815" y="1132" as="sourcePoint" /><mxPoint x="1847" y="1132" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="63" edge="1" parent="1" style="html=1;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#0F172A;fontColor=#0F172A;fontSize=10;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="1815" y="1242" as="sourcePoint" /><mxPoint x="1847" y="1242" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="64" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=11;align=left;verticalAlign=top;spacing=12;shadow=1;arcSize=6;" value="&lt;b&gt;📐 EVOLUÇÃO DA MÁQUINA DE ESTADOS: FASE 3 (MONÓLITO POSTGRESQL) ➔ FASE 4 (SAGA &amp;amp; DYNAMODB SINGLE-TABLE)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Fase 3 (Legado Monolítico):&lt;/b&gt; Possuía 9 status lineares na OS (&lt;code&gt;RECEIVED&lt;/code&gt; ➔ &lt;code&gt;IN_DIAGNOSIS&lt;/code&gt; ➔ &lt;code&gt;WAITING_APPROVAL&lt;/code&gt; ➔ &lt;code&gt;APPROVED&lt;/code&gt;/&lt;code&gt;REFUSED&lt;/code&gt; ➔ &lt;code&gt;IN_EXECUTION&lt;/code&gt; ➔ &lt;code&gt;FINALIZED&lt;/code&gt; ➔ &lt;code&gt;PAID&lt;/code&gt; + &lt;code&gt;CANCELED&lt;/code&gt;) e 3 status em execução (&lt;code&gt;INITIATED&lt;/code&gt; ➔ &lt;code&gt;PENDDING&lt;/code&gt; ➔ &lt;code&gt;FINALIZED&lt;/code&gt;), todos persistidos em PostgreSQL RDS.&lt;br/&gt;&amp;bull; &lt;b&gt;Fase 4 (Arquitetura Distribuída):&lt;/b&gt; Expande para 12 estados oficiais na OS com a sub-máquina intermediária de execuções extras (&lt;code&gt;WAITING_APPROVAL_EXTRA_TASKS&lt;/code&gt;, &lt;code&gt;APPROVAL_EXTRA_TASKS&lt;/code&gt;, &lt;code&gt;REFUSED_EXTRA_TASKS&lt;/code&gt;), corrige &lt;code&gt;PENDDING&lt;/code&gt; ➔ &lt;code&gt;PENDING&lt;/code&gt;, introduz &lt;code&gt;ExtraExecutionDynamoItem&lt;/code&gt; (&lt;code&gt;WAITING_APPROVAL&lt;/code&gt; / &lt;code&gt;APPROVED&lt;/code&gt; / &lt;code&gt;REFUSED&lt;/code&gt;) e integra transições assíncronas via AWS SQS (&lt;code&gt;callback-approve-notification-queue&lt;/code&gt; e &lt;code&gt;payment-success-queue&lt;/code&gt;)." vertex="1"><mxGeometry height="150" width="1860" x="40" y="1385" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
