        <mxCell id="59" edge="1" parent="1" style="html=1;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#1E293B;fontColor=#1E293B;fontSize=10;strokeWidth=1.5;" value=""><mxGeometry relative="1" as="geometry"><mxPoint x="1054" y="1180" as="sourcePoint" /><mxPoint x="1135" y="1180" as="targetPoint" /></mxGeometry></mxCell>
