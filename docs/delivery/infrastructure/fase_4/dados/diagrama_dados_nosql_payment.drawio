<mxfile host="app.diagrams.net" modified="2026-11-15T01:25:00.000Z" agent="Antigravity AI Architecture Agent" version="24.0.0" type="device">
  <diagram id="diag_nosql_payment" name="Dados NoSQL - tb-payment (Fase 4)">
    <mxGraphModel dx="1900" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=1;arcSize=10;" value="&lt;b&gt;DIAGRAMA DE DADOS NoSQL (DYNAMODB): CONTEXTO PAYMENT-SERVICE (FASE 4)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; font-weight: normal; opacity: 0.9;&quot;&gt;Amazon DynamoDB • Tabela tb-payment-&amp;lt;env&amp;gt; (Single-Table Design) • PK: BILLING#&amp;lt;service_order_id&amp;gt; • SK Polimórfica • GSI: dispatch-notification-index • ADR-016 / ADR-018&lt;/span&gt;" vertex="1"><mxGeometry height="66" width="1820" x="40" y="20" as="geometry" /></mxCell>
        <mxCell id="3" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;width=730;height=28;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#EFF6FF;strokeColor=#1D4ED8;strokeWidth=1.6;fontColor=#1E3A8A;fontSize=11;" value="&lt;b&gt;AMAZON DYNAMODB — TABELA tb-payment-&amp;lt;env&amp;gt; (SINGLE-TABLE DESIGN | PAY_PER_REQUEST | PITR + SSE)&lt;/b&gt;" vertex="1"><mxGeometry height="885" width="1820" x="40" y="106" as="geometry" /></mxCell>
        <mxCell id="4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;🔑 Estrutura de Chave Primária Composta (Hash + Range Key) &amp;amp; Global Secondary Index (GSI)&lt;/b&gt;&lt;br/&gt;• Base Table Keys:  PK (String) = &amp;quot;BILLING#&amp;lt;service_order_id&amp;gt;&amp;quot;   |   SK (String) = &amp;quot;PAY#&amp;lt;timestamp&amp;gt;#&amp;lt;payment_id&amp;gt;&amp;quot;   ou   &amp;quot;INV#&amp;lt;timestamp&amp;gt;#&amp;lt;invoice_id&amp;gt;&amp;quot;&lt;br/&gt;• GSI [dispatch-notification-index]:  GSI-PK = dispatch_notificate_status (PENDING | DISPATCHED | FAILED)   |   GSI-SK = payment_date (ISO-8601)   |   Projection = ALL" vertex="1"><mxGeometry height="74" width="1770" x="65" y="148" as="geometry" /></mxCell>
        <mxCell id="5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;item_payment&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;PaymentDynamoItem.kt (Pagamento / PIX / Estorno)&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] PK&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S: BILLING#&amp;lt;service_order_id&amp;gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[SK] SK&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S: PAY#&amp;lt;ts&amp;gt;#&amp;lt;payment_id&amp;gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;entityType&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (&amp;quot;PAYMENT&amp;quot;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;payment_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (ID Mercado Pago ou FALLBACK)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;service_order_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (UUID - Ref. OS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;customer_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (UUID - Ref. SQL)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;price_value&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;N (Double)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[GSI-SK] payment_date&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (ISO-8601 UTC)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;status&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (PENDING|APPROVED|REFUSED|REFUNDED)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;payment_method&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (MERCADO_PAGO_QR|CONTINGENCY|PIX)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;os_update_status&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (PENDING|UPDATED)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;payment_info&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (Payload BR Code / QR PIX)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;service_order_dispatch_notificate&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (PENDING|DISPATCHED)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;client_dispatch_notificate&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (PENDING|DISPATCHED)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[GSI-PK] dispatch_notificate_status&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (PENDING|DISPATCHED|FAILED)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;origin_trace_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S? (W3C traceparent)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;refund_reason&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S? (Motivo estorno Saga)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;refund_date&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S? (ISO-8601 - Refund)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="506" width="535" x="65" y="280" as="geometry" /></mxCell>
        <mxCell id="6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3730A3;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;item_invoice&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;InvoiceDynamoItem.kt (Fatura da OS)&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] PK&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S: BILLING#&amp;lt;service_order_id&amp;gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[SK] SK&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S: INV#&amp;lt;ts&amp;gt;#&amp;lt;invoice_id&amp;gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;entityType&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (&amp;quot;INVOICE&amp;quot;)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;invoice_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (UUID)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;service_order_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (UUID - Ref. OS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;customer_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (UUID - Ref. SQL)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;invoice_number&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (ex: INV-572540)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;price_value&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;N (Double)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;emission_date&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (ISO-8601 UTC)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;invoice_info&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (Descrição fatura)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;client_dispatch&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (PENDING|DISPATCHED)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="331" width="495" x="670" y="280" as="geometry" /></mxCell>
        <mxCell id="7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;🔎 GSI dispatch-notification-index &amp;amp; Access Patterns O(1)&lt;/b&gt;&lt;br/&gt;1. Consultar Cobrança Completa da OS (Query PK = &amp;quot;BILLING#&amp;lt;orderId&amp;gt;&amp;quot;):&lt;br/&gt;   ➔ Recupera simultaneamente todas as tentativas PAY# e faturas INV#.&lt;br/&gt;2. Buscar Pagamento Específico (GetItem PK + SK = &amp;quot;PAY#&amp;lt;ts&amp;gt;#&amp;lt;payId&amp;gt;&amp;quot;):&lt;br/&gt;   ➔ Lookup O(1) para confirmação manual ou webhook do Mercado Pago.&lt;br/&gt;3. Reconciliação via Scheduler (Query IndexName = &amp;quot;dispatch-notification-index&amp;quot;):&lt;br/&gt;   ➔ scheduler_os_payment_atualization (15m) varre registros com&lt;br/&gt;     dispatch_notificate_status = &amp;quot;PENDING&amp;quot;, ordenados por payment_date,&lt;br/&gt;     e garante entrega idempotente às filas SQS:&lt;br/&gt;     • payment-success-queue (atualiza OS para status = PAID)&lt;br/&gt;     • payment-notification-queue (dispara recibo/alerta via Mailpit)." vertex="1"><mxGeometry height="315" width="595" x="1240" y="280" as="geometry" /></mxCell>
        <mxCell id="8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCA5A5;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;🛡️ Circuit Breaker (Mercado Pago) &amp;amp; Compensação Financeira&lt;/b&gt;&lt;br/&gt;• Gateway MercadoPagoGatewayImpl protegido por Resilience4j Circuit Breaker.&lt;br/&gt;• Estado CLOSED (Normal): chama POST /v1/payments no Mercado Pago,&lt;br/&gt;  persiste payment_id oficial e QR PIX em payment_info.&lt;br/&gt;• Estado OPEN / Fallback: gera ID determinístico FALLBACK-MP-* com&lt;br/&gt;  payment_method = MERCADO_PAGO_CONTINGENCY e BR Code PIX válido,&lt;br/&gt;  garantindo disponibilidade contínua da oficina sem perda de faturamento.&lt;br/&gt;• Estorno / Compensação (ADR-015):&lt;br/&gt;  POST /payment/{id}/refund atualiza status = &amp;quot;REFUNDED&amp;quot;, preenche&lt;br/&gt;  refund_reason + refund_date e publica payment_refunded na SQS." vertex="1"><mxGeometry height="335" width="595" x="1240" y="625" as="geometry" /></mxCell>
        <mxCell id="9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;📡 Integração com Filas AWS SQS &amp;amp; Observabilidade&lt;/b&gt;&lt;br/&gt;• Entrada Assíncrona: PaymentSqsConsumer consome&lt;br/&gt;  os-ready-for-payment-queue (com DLQ e Redrive Policy).&lt;br/&gt;• Saídas Assíncronas (PaymentSqsProducer):&lt;br/&gt;  1. payment-success-queue ➔ service-order-execution-service&lt;br/&gt;  2. payment-notification-queue ➔ notification-service&lt;br/&gt;• Correlação OTel W3C: origin_trace_id salvo em item_payment&lt;br/&gt;  conecta os spans entre webhooks, confirmações REST e SQS." vertex="1"><mxGeometry height="270" width="495" x="670" y="690" as="geometry" /></mxCell>
        <mxCell id="10" edge="1" parent="1" style="html=1;startArrow=none;endArrow=none;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#1D4ED8;fontColor=#1D4ED8;fontSize=10;strokeWidth=1.6;" value="PK Compartilhada: BILLING#&lt;orderId&gt;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="635" y="342.5" /><mxPoint x="635" y="250" /></Array><mxPoint x="600" y="342.5" as="sourcePoint" /><mxPoint x="670" y="342.5" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="11" edge="1" parent="1" style="html=1;startArrow=none;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#166534;fontColor=#166534;fontSize=10;strokeWidth=1.6;dashed=1;" value="GSI Index Query (PENDING)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="625" y="692.5" /><mxPoint x="625" y="645" /><mxPoint x="1202" y="645" /><mxPoint x="1202" y="430" /></Array><mxPoint x="600" y="692.5" as="sourcePoint" /><mxPoint x="1240" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=left;verticalAlign=top;spacing=12;shadow=1;arcSize=6;" value="&lt;b&gt;📐 EVOLUÇÃO DE FATURAMENTO E PAGAMENTOS: FASE 3 (tb_invoice RDS) ➔ FASE 4 (tb-payment DYNAMODB SINGLE-TABLE)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Fase 3 (Legado SQL — database-er-diagram.png):&lt;/b&gt; Apenas a tabela relacional tb_invoice existia acoplada por FKs a tb_customer e tb_service_order, sem modelo de pagamento persistente, sem controle de tentativas ou contingência de gateway e sem trilha de estorno/compensação de Saga.&lt;br/&gt;&amp;bull; &lt;b&gt;Fase 4 (Bounded Context Payment — tb-payment Single-Table Design):&lt;/b&gt; Unifica faturas (INV#) e ciclos completos de pagamento/estorno (PAY#) sob a mesma Partition Key BILLING#&amp;lt;service_order_id&amp;gt;, eliminando acoplamento com o RDS e utilizando o GSI dispatch-notification-index para garantir consistência eventual (Outbox Pattern) com service-order-execution-service e notification-service." vertex="1"><mxGeometry height="212" width="1820" x="40" y="1012" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
