<mxfile host="app.diagrams.net" modified="2026-11-15T01:25:00.000Z" agent="Antigravity AI Architecture Agent" version="24.0.0" type="device">
  <diagram id="diag_sql_register" name="Dados SQL - Register Service (Fase 4)">
    <mxGraphModel dx="1920" dy="1210" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1210" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=1;arcSize=10;" value="&lt;b&gt;DIAGRAMA DE DADOS SQL (RELACIONAL): CONTEXTO REGISTER-SERVICE (FASE 4)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; font-weight: normal; opacity: 0.9;&quot;&gt;Amazon RDS PostgreSQL 16 (register-db) + ElastiCache Redis 7.0 (user-login-cache) • Flyway V1__init_register_schema.sql • ADR-002 / ADR-016 / ADR-019&lt;/span&gt;" vertex="1"><mxGeometry height="66" width="1840" x="40" y="20" as="geometry" /></mxCell>
        <mxCell id="3" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;width=570;height=28;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#F0FDF4;strokeColor=#15803D;strokeWidth=1.6;fontColor=#14532D;fontSize=11;" value="&lt;b&gt;AMAZON RDS POSTGRESQL 16 (register-db) — PERSISTÊNCIA RELACIONAL SQL&lt;/b&gt;" vertex="1"><mxGeometry height="845" width="1300" x="40" y="106" as="geometry" /></mxCell>
        <mxCell id="4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3730A3;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;tb_user&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;Entidade: UserEntity.kt (Autenticação &amp;amp; RBAC)&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] id_tb_user&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;UUID NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;name&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(150) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;function&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(50) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[UK] cpf&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(14) NOT NULL UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[UK] email&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(255) NOT NULL UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;phone&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(20) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;password&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(255) NOT NULL (BCrypt)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="231" width="355" x="65" y="165" as="geometry" /></mxCell>
        <mxCell id="5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#166534;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;tb_customer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;Entidade: CustomerEntity.kt (Clientes)&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] id_tb_customer&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;UUID NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;name&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(150) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[UK] document&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(14) NOT NULL UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[UK] email&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(255) UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;phone&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(20) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;birth_date&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;DATE NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;created&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;TIMESTAMP NOT NULL (DEFAULT)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;updated&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;TIMESTAMP NOT NULL (DEFAULT)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="256" width="355" x="510" y="165" as="geometry" /></mxCell>
        <mxCell id="6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#115E59;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;tb_vehicle&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;Entidade: VehicleEntity.kt (Frota)&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] id_tb_vehicle&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;UUID NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[FK] customer_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;UUID NOT NULL (FK CASCADE)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[UK] plate&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(7) NOT NULL UNIQUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;brand&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(50) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;model&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(80) NOT NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;color&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(30) NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;manufacturing_date&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;DATE NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;last_maintenance&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;TIMESTAMP NULL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;created&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;TIMESTAMP NOT NULL (DEFAULT)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;updated&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;TIMESTAMP NOT NULL (DEFAULT)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="306" width="360" x="955" y="165" as="geometry" /></mxCell>
        <mxCell id="7" edge="1" parent="1" style="html=1;startArrow=ERone;endArrow=ERmany;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#0F766E;fontColor=#0F766E;fontSize=10;strokeWidth=1.6;" value="1 : 0..N&#10;ON DELETE CASCADE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="227.5" /><mxPoint x="910" y="252.5" /></Array><mxPoint x="865" y="227.5" as="sourcePoint" /><mxPoint x="955" y="252.5" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="8" edge="1" parent="1" style="html=1;startArrow=none;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#4338CA;fontColor=#4338CA;fontSize=10;strokeWidth=1.6;dashed=1;" value="Correlação&#10;CPF / Doc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="465" y="302.5" /><mxPoint x="465" y="277.5" /></Array><mxPoint x="420" y="302.5" as="sourcePoint" /><mxPoint x="510" y="277.5" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;🔐 Value Objects JPA, Flyway &amp;amp; Regras de Segurança&lt;/b&gt;&lt;br/&gt;• Flyway Migration: V1__init_register_schema.sql aplica DDL determinístico no RDS.&lt;br/&gt;• Conversores JPA (@Convert): DocumentConverter (CPF/CNPJ), EmailConverter e PlateConverter.&lt;br/&gt;• Enum UserRole (tb_user.function): ATTENDANT (operadores) e CUSTOMER (clientes).&lt;br/&gt;• Integridade Referencial: CASCADE ao excluir cliente remove veículos vinculados.&lt;br/&gt;• Proteção de Exclusão Cruzada: ServiceOrderExistenceChecker consulta REST&lt;br/&gt;  service-order-execution-service antes de deletar cliente/veículo com OS ativa.&lt;br/&gt;• Credenciais: BCrypt para password; Spring Security + JWT stateless por perfil.&lt;br/&gt;• Infra RDS (infra-db-rds): Postgres 16 gp3 criptografado em Private Subnets (:5432)." vertex="1"><mxGeometry height="340" width="610" x="65" y="580" as="geometry" /></mxCell>
        <mxCell id="10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;🧹 Desidratação Relacional na Fase 4 (ADR-016 &amp;amp; ADR-019)&lt;/b&gt;&lt;br/&gt;• FASE 3 (Legado Monolítico): 10 tabelas no mesmo schema SQL acoplando cadastro,&lt;br/&gt;  ordens de serviço, histórico, execuções, insumos (tb_insume) e faturas.&lt;br/&gt;• FASE 4 (Bounded Context Register): RDS reduzido a apenas 3 tabelas de identidade&lt;br/&gt;  e cadastro (tb_user, tb_customer, tb_vehicle), com menor pool e IOPS.&lt;br/&gt;• ADR-019 (Remoção de tb_insume): CRUD relacional de estoque removido do&lt;br/&gt;  register-service; insumos vivem embutidos em item_execution.insumes no DynamoDB.&lt;br/&gt;• Migração para NoSQL: tb_service_order, tb_execution e históricos foram para&lt;br/&gt;  tb-service_order; tb_invoice e cobranças foram para tb-payment (DynamoDB)." vertex="1"><mxGeometry height="340" width="615" x="700" y="580" as="geometry" /></mxCell>
        <mxCell id="11" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;width=395;height=28;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.6;fontColor=#9A3412;fontSize=11;" value="&lt;b&gt;CACHE REDIS &amp;amp; REFERÊNCIAS CROSS-CONTEXT&lt;/b&gt;" vertex="1"><mxGeometry height="845" width="505" x="1375" y="106" as="geometry" /></mxCell>
        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;⚡ Amazon ElastiCache Redis 7.0 (user-login-cache)&lt;/b&gt;&lt;br/&gt;• Cluster Terraform: &amp;lt;cluster&amp;gt;-user-login-cache-&amp;lt;env&amp;gt;&lt;br/&gt;• Porta / Motor: TCP 6379 • Engine redis 7.0 (default.redis7)&lt;br/&gt;• Rede Privada: ElastiCache Subnet Group nas Private Subnets&lt;br/&gt;• Security Group: Ingress :6379 restrito à VPC (10.0.0.0/16)&lt;br/&gt;• Função: Cache de sessões ativas, tokens JWT e aceleração&lt;br/&gt;  de consultas de login no fluxo Lambda Auth ➔ register-service&lt;br/&gt;• Escopo: Dados voláteis com TTL curto; fonte da verdade&lt;br/&gt;  persistente continua no PostgreSQL tb_user." vertex="1"><mxGeometry height="255" width="455" x="1400" y="165" as="geometry" /></mxCell>
        <mxCell id="13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;🔗 Chaves Lógicas Consumidas por Outros Contextos&lt;/b&gt;&lt;br/&gt;Na Fase 4 não existem FKs SQL distribuídas entre bancos.&lt;br/&gt;Apenas os identificadores UUID são propagados via REST/SQS:&lt;br/&gt;1. lambda-auth ➔ register-service (OpenFeign NLB :8080):&lt;br/&gt;   POST /auth/login valida cpf + BCrypt em tb_user.&lt;br/&gt;2. service-order-execution-service (DynamoDB tb-service_order):&lt;br/&gt;   Persiste customer_id e vehicle_id como strings UUID em&lt;br/&gt;   item_service_order_metadata (PK ORDER#&amp;lt;id&amp;gt;, SK METADATA).&lt;br/&gt;3. payment-service (DynamoDB tb-payment):&lt;br/&gt;   Persiste customer_id em item_payment e item_invoice.&lt;br/&gt;4. notification-service (Stateless):&lt;br/&gt;   Recebe dados de destino nos eventos SQS para envio SMTP.&lt;br/&gt;5. Observabilidade: Logs e traces correlacionados via traceparent." vertex="1"><mxGeometry height="470" width="455" x="1400" y="450" as="geometry" /></mxCell>
        <mxCell id="14" edge="1" parent="1" style="html=1;startArrow=none;endArrow=block;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#C2410C;fontColor=#C2410C;fontSize=10;strokeWidth=1.6;dashed=1;" value="Cache Sessão / Tokens JWT (Redis :6379)"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="242.5" y="525" /><mxPoint x="1358" y="525" /><mxPoint x="1358" y="290" /></Array><mxPoint x="242.5" y="396" as="sourcePoint" /><mxPoint x="1400" y="290" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#1E293B;fontSize=11;align=left;verticalAlign=top;spacing=12;shadow=1;arcSize=6;" value="&lt;b&gt;📌 COMPARATIVO SQL: FASE 3 (MONÓLITO POSTGRESQL) ➔ FASE 4 (BOUNDED CONTEXT REGISTER-DB + REDIS)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&amp;bull; &lt;b&gt;Fase 3 (Legado — database-er-diagram.png):&lt;/b&gt; Um único banco Amazon RDS PostgreSQL armazenava 10 tabelas operacionais e cadastrais acopladas por chaves estrangeiras físicas (tb_user, tb_customer, tb_vehicle, tb_service_order, tb_service_order_history, tb_execution, tb_execution_history, tb_execution_insume, tb_insume e tb_invoice), gerando contenção e deploy monolítico.&lt;br/&gt;&amp;bull; &lt;b&gt;Fase 4 (Persistência Poliglota — ADR-016 + ADR-019):&lt;/b&gt; O Amazon RDS PostgreSQL 16 (register-db) foi focado estritamente nas entidades ACID de identidade e frota (tb_user, tb_customer, tb_vehicle) apoiado pelo Redis, enquanto os domínios transacionais de OS e Pagamentos passaram para tabelas Amazon DynamoDB em Single-Table Design com escala elástica sob demanda." vertex="1"><mxGeometry height="215" width="1840" x="40" y="972" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
