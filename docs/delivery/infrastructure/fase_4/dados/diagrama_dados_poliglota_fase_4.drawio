        <mxCell id="2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;align=center;verticalAlign=middle;shadow=1;arcSize=10;" value="&lt;b&gt;ARQUITETURA DE DADOS E PERSISTÊNCIA POLIGLOTA (SQL + NoSQL DYNAMODB — FASE 4)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px; font-weight: normal; opacity: 0.9;&quot;&gt;Database-per-Service (ADR-016) • Amazon RDS PostgreSQL 16 + ElastiCache Redis (register) • Amazon DynamoDB Single-Table (service-order &amp;amp; payment) • Zero Cross-DB Joins&lt;/span&gt;" vertex="1"><mxGeometry height="66" width="2380" x="40" y="20" as="geometry" /></mxCell>
