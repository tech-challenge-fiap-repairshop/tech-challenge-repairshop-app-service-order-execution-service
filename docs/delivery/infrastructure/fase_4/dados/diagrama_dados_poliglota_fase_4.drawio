        <mxCell id="4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3730A3;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;tb_user&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;PostgreSQL (register-db)&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] id_tb_user&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[UK] cpf / email&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;name / phone&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;function&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;UserRole&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;password&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;BCrypt&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="181" width="245" x="65" y="190" as="geometry" /></mxCell>
        <mxCell id="5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#166534;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;tb_customer&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;PostgreSQL (register-db)&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] id_tb_customer&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[UK] document&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(14)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[UK] email&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(255)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;name / phone&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;birth_date&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;DATE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;created / updated&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="206" width="245" x="330" y="190" as="geometry" /></mxCell>
        <mxCell id="6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#115E59;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;tb_vehicle&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;PostgreSQL (register-db)&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] id_tb_vehicle&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;UUID&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[FK] customer_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;UUID (CASCADE)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[UK] plate&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR(7)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;brand / model / color&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;VARCHAR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;manufacturing_date&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;DATE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;last_maintenance&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;TIMESTAMP&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1"><mxGeometry height="206" width="315" x="175" y="475" as="geometry" /></mxCell>
        <mxCell id="7" edge="1" parent="1" style="html=1;startArrow=ERone;endArrow=ERmany;rounded=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#0F766E;fontColor=#0F766E;fontSize=10;strokeWidth=1.6;" value="1 : 0..N"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="452.5" y="435" /><mxPoint x="332.5" y="435" /></Array><mxPoint x="452.5" y="396" as="sourcePoint" /><mxPoint x="332.5" y="475" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;⚡ ElastiCache Redis 7.0 (user-login-cache :6379)&lt;/b&gt;&lt;br/&gt;• Cache in-memory para sessões de login / JWT no register-service.&lt;br/&gt;• Subnets Privadas VPC (10.0.2.0/24 e 10.0.3.0/24).&lt;br/&gt;• Fonte persistente ACID mantida no Amazon RDS PostgreSQL 16." vertex="1"><mxGeometry height="175" width="510" x="65" y="735" as="geometry" /></mxCell>
        <mxCell id="9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;fontColor=#1E293B;fontSize=10.5;align=left;verticalAlign=top;spacing=10;shadow=1;arcSize=6;" value="&lt;b&gt;🧹 Exclusão de tb_insume (ADR-019)&lt;/b&gt;&lt;br/&gt;• Tabela relacional tb_insume eliminada do register-service.&lt;br/&gt;• Insumos passaram a ser documentos embutidos dentro de&lt;br/&gt;  item_execution.insumes no DynamoDB (tb-service_order)." vertex="1"><mxGeometry height="165" width="510" x="65" y="930" as="geometry" /></mxCell>
        <mxCell id="10" parent="1" style="shape=umlFrame;whiteSpace=wrap;html=1;width=560;height=28;boundedLbl=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#F0FDFA;strokeColor=#0F766E;strokeWidth=1.6;fontColor=#115E59;fontSize=11;" value="&lt;b&gt;CONTEXTO 2: SERVICE-ORDER-EXECUTION (DYNAMODB tb-service_order)&lt;/b&gt;" vertex="1"><mxGeometry height="1015" width="940" x="680" y="108" as="geometry" /></mxCell>
        <mxCell id="11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#115E59;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;item_service_order_metadata&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;PK: ORDER#&amp;lt;id&amp;gt; | SK: METADATA&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] PK&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;ORDER#&amp;lt;service_order_id&amp;gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[SK] SK&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;METADATA&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;service_order_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (UUID)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;customer_id / vehicle_id&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (Ref. SQL UUID)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;status&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (12 estados OS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;total_service_order_price&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;N (Double)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;payment_status&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (PENDING|PAID|REFUNDED)&lt;/td&gt