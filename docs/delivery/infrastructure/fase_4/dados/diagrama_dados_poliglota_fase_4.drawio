        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;strokeWidth=1.8;fontColor=#0F172A;fontSize=11;align=left;verticalAlign=top;spacing=6;shadow=1;arcSize=6;" value="&lt;b&gt;item_execution&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px;opacity:0.9;&quot;&gt;PK: ORDER#&amp;lt;id&amp;gt; | SK: EXEC#&amp;lt;ts&amp;gt;#&amp;lt;id&amp;gt;&lt;/span&gt;&lt;hr style=&quot;margin:4px 0;&quot;/&gt;&lt;table style=&quot;width:100%;font-size:10px;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[PK] PK&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;ORDER#&amp;lt;service_order_id&amp;gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[SK] SK&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;EXEC#&amp;lt;ts&amp;gt;#&amp;lt;execId&amp;gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;execution_id / task_name&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;execution_price&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;N (Double)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;status&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;S (INITIATED|PENDING|FINALIZED)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;estimated_time / interval&lt;/td&gt;&lt;td style=&quot;padding:2px 6px;color:#475569;text-align:right;&quot;&gt;N&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:2px 6px;font-weight:bold;&quot;&gt;[L&amp;lt;M&amp;gt;] insumes [List&amp;lt;Insume&amp;gt;]&lt;/td&gt;&lt;td style=&quot;